# Database (Neon via Vercel Marketplace). DATABASE_URL is pooled; DIRECT_URL is for migrations.
DATABASE_URL=
DIRECT_URL=

# GitHub (GraphQL needs a token; a fine-grained token with public read access is enough)
GITHUB_TOKEN=

# Public URL of the app, used for share links and OG images
NEXT_PUBLIC_SITE_URL=

# Amazon S3 (presigned uploads)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Playwright against a deployed preview (optional)
PLAYWRIGHT_BASE_URL=
